---
import Base from "../layouts/Base.astro";
import { buildListing, loadMeta } from "../lib/corpus.js";
import Kartu from "../components/Kartu.astro";
import { statusLabel, typeLabel, CATEGORIES } from "../lib/labels.js";
import { PAGE } from "../lib/listing.js";
import { KINDS } from "../lib/collection/records.js";

const rows = buildListing();
const meta = loadMeta();
const base = import.meta.env.BASE_URL;
const withoutText = rows.filter((r) => !r.text_available).length;
const uncertain = rows.filter((r) => r.status_uncertain).length;

// Filter choices come from the data, each with how many documents it holds.
const countBy = (key) => {
  const counts = new Map();
  for (const row of rows) counts.set(key(row), (counts.get(key(row)) || 0) + 1);
  return counts;
};
const typeCounts = [...countBy((r) => r.code)].sort((a, b) => typeLabel(a[0]).localeCompare(typeLabel(b[0]), "id"));
const statusOrder = ["berlaku", "diubah_atau_dicabut_sebagian", "tidak_berlaku", "tidak_pasti", "tetap", "kosong"];
const statusCounts = [...countBy((r) => r.status)].sort(
  (a, b) => (statusOrder.indexOf(a[0]) + 99) % 99 - (statusOrder.indexOf(b[0]) + 99) % 99
);
const categoryCounts = CATEGORIES.map((name) => [name, rows.filter((r) => r.categories.includes(name)).length]).filter(
  ([, count]) => count > 0
);
// Tappable examples, one of each kind of search an officer or a member of the public makes.
// "lebar-saja": shown on wide screens only, so the examples stay within two rows on a phone.
const examples = [
  ["PMK 168/2023", "nomor peraturan"],
  ["PPh 21", "singkatan"],
  ["PTKP", "singkatan", "lebar-saja"],
  ["jual rumah kena pajak berapa", "pertanyaan sehari-hari"],
  ["restitusi PPN", "istilah", "lebar-saja"],
  ["faktur pajak", "istilah"],
];
const years = [...new Set(rows.map((r) => Number(r.year)).filter(Boolean))].sort((a, b) => b - a);
---

<Base title="Saku Pajak — cari peraturan pajak">
  <h1>Cari peraturan pajak</h1>
  <p class="lead">
    PPh, KUP, dan PPN: {rows.length.toLocaleString("id-ID")} dokumen dari katalog Direktorat Jenderal
    Pajak dan JDIH Kementerian Keuangan.
  </p>

  <form class="cari" id="cari" role="search" action="" method="get">
    <label for="q">Ketik nomor peraturan, istilah, atau pertanyaan</label>
    <div class="cari-baris">
      <input id="q" name="q" type="search" autocomplete="off" spellcheck="false" enterkeyhint="search"
        placeholder="mis. PMK 168/2023 atau jual rumah" />
      <button type="submit">Cari</button>
    </div>
    {/* Examples are plain #q= links: the page already searches when the fragment changes. */}
    <p class="contoh">
      <span class="contoh-judul">Contoh:</span>
      {examples.map(([query, kind, only]) => (
        <a class={only ? `contoh-q ${only}` : "contoh-q"} href={`#q=${encodeURIComponent(query)}`} title={kind}>{query}</a>
      ))}
    </p>
    <details class="saringan-lipat" id="saringan-lipat">
      <summary>Saring <span id="saringan-aktif"></span></summary>
    <div class="saringan">
      <label>Kategori
        <select name="kategori" id="kategori">
          <option value="">Semua kategori</option>
          {categoryCounts.map(([name, count]) => <option value={name}>{name} ({count})</option>)}
        </select>
      </label>
      <label>Jenis
        <select name="jenis" id="jenis">
          <option value="">Semua jenis</option>
          {typeCounts.map(([code, count]) => <option value={code}>{typeLabel(code)} ({count})</option>)}
        </select>
      </label>
      <label>Dari tahun
        <select name="dari" id="dari">
          <option value="">—</option>
          {years.slice().reverse().map((year) => <option value={year}>{year}</option>)}
        </select>
      </label>
      <label>Sampai tahun
        <select name="sampai" id="sampai">
          <option value="">—</option>
          {years.map((year) => <option value={year}>{year}</option>)}
        </select>
      </label>
      <label>Sumber
        <select name="sumber" id="sumber">
          <option value="">Peraturan publik dan koleksi pribadi</option>
          <option value="publik">Hanya peraturan publik</option>
          <option value="pribadi">Hanya koleksi pribadi</option>
        </select>
      </label>
      <label>Jenis koleksi
        <select name="koleksi" id="jenis-koleksi">
          <option value="">Semua jenis koleksi</option>
          {Object.entries(KINDS).map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
      <label>Status
        <select name="status" id="status">
          <option value="">Semua status</option>
          {statusCounts.map(([value, count]) => <option value={value}>{statusLabel(value)} ({count})</option>)}
        </select>
      </label>
    </div>
    </details>
    <p class="hint" id="keadaan" aria-live="polite">
      Pencarian berjalan di perangkat ini. Data pencariannya dimuat sekali bersama halaman; mengetik
      tidak mengirim apa pun ke mana pun.
    </p>
    <noscript>
      <p class="hint">
        Pencarian dan saringan membutuhkan JavaScript. Daftar lengkap ada di
        <a href={`${base}semua/`}>halaman daftar lengkap</a>.
      </p>
    </noscript>
  </form>

  <div id="hasil" hidden>
    <div class="notice" id="catatan-daerah" hidden></div>
    <section class="blok-pribadi" id="hasil-pribadi" hidden aria-label="Hasil dari koleksi pribadi">
      <h2>Koleksi pribadi</h2>
      <p class="hasil-ringkas" id="hasil-pribadi-ringkas"></p>
      <ol class="daftar" id="hasil-pribadi-daftar"></ol>
      <button type="button" class="tombol-lagi" id="lagi-pribadi" hidden>Tampilkan lebih banyak</button>
    </section>
    <section id="hasil-publik" aria-label="Hasil dari peraturan publik">
      <p class="hasil-ringkas" id="hasil-ringkas"></p>
      <details class="cara-cari" id="cara-cari" hidden>
        <summary>Bagaimana kata Anda dicari</summary>
        <div id="cara-cari-isi"></div>
      </details>
      <section class="blok-kategori" id="hasil-kategori" hidden aria-labelledby="judul-kategori">
        <h2 id="judul-kategori">Teratas per kategori</h2>
        <p class="hint">Tiga hasil terbaik dari tiap kategori pajak, diambil dari daftar di bawah.</p>
        <div id="kategori-grup"></div>
        <h2>Semua hasil</h2>
      </section>
      <ol class="daftar" id="hasil-daftar"></ol>
      <button type="button" class="tombol-lagi" id="lagi" hidden>Tampilkan lebih banyak</button>
    </section>
  </div>


  <p class="catatan-data">
    {uncertain.toLocaleString("id-ID")} dokumen dicatat dengan status berbeda oleh sumbernya, dan
    {" "}{withoutText.toLocaleString("id-ID")} dokumen tanpa teks karena sumbernya hanya memuat data
    ringkas. Semuanya tetap ditampilkan. <a class="info" href={`${base}cara-pakai/#status`} aria-label="Arti status menurut sumber">ⓘ</a>
  </p>

  <div id="semua">
  <div class="toolbar">
    <label for="urut">Urutkan</label>
    <select id="urut">
      <option value="tahun-desc">Tahun, terbaru dulu</option>
      <option value="tahun-asc">Tahun, terlama dulu</option>
      <option value="judul-asc">Judul, A ke Z</option>
      <option value="jenis-asc">Jenis peraturan</option>
      <option value="status-asc">Status</option>
    </select>
    <p class="hint" id="hint">Dokumen yang dicatat berbeda oleh dua sumber selalu ditampilkan berdampingan.</p>
  </div>

  <p class="hint" id="jumlah-tampil" aria-live="polite"></p>
  <ol class="daftar" id="daftar">
    {rows.slice(0, PAGE).map((row) => <Kartu row={row} />)}
  </ol>
  {/* The other cards: parsed with the page but not laid out until shown (K-074). */}
  <template id="daftar-sisa">
    {rows.slice(PAGE).map((row) => <Kartu row={row} />)}
  </template>
  <button type="button" class="tombol-lagi" id="lagi-daftar" hidden>Tampilkan lagi</button>
  <noscript>
    <p class="hint">
      Daftar ini menampilkan {PAGE} dokumen pertama. Tanpa JavaScript, daftar lengkap
      {rows.length.toLocaleString("id-ID")} dokumen ada di <a href={`${base}semua/`}>halaman daftar lengkap</a>.
    </p>
  </noscript>
  </div>

  <p class="hint">Korpus berisi {meta.body_units.toLocaleString("id-ID")} unit pasal dan diktum.</p>
</Base>

<script>
  import { createListing } from "../lib/listing.js";
  import { startSearch } from "../lib/search/ui.js";

  // Ordering, filters and "show more" share one listing, so they can never disagree (K-074).
  // Sorting happens in the browser so the page keeps working offline and needs no server.
  const listing = createListing({
    list: document.getElementById("daftar"),
    rest: document.getElementById("daftar-sisa"),
    more: document.getElementById("lagi-daftar"),
    count: document.getElementById("jumlah-tampil"),
  });
  const select = document.getElementById("urut");

  const key = (item, name) => item.dataset[name] || "";
  const comparators = {
    // an unreadable year sorts last in both directions rather than pretending to be year 0
    "tahun-desc": (a, b) => (Number(key(b, "tahun")) || -1) - (Number(key(a, "tahun")) || -1),
    "tahun-asc": (a, b) => (Number(key(a, "tahun")) || 9999) - (Number(key(b, "tahun")) || 9999),
    "judul-asc": (a, b) => key(a, "judul").localeCompare(key(b, "judul"), "id"),
    "jenis-asc": (a, b) => key(a, "jenis").localeCompare(key(b, "jenis"), "id"),
    "status-asc": (a, b) => key(a, "status").localeCompare(key(b, "status"), "id"),
  };

  select.addEventListener("change", () => {
    const compare = comparators[select.value];
    listing.sort(
      (a, b) =>
        compare(a, b) ||
        // documents recorded twice stay next to each other under every ordering
        key(a, "group").localeCompare(key(b, "group")) ||
        key(a, "id").localeCompare(key(b, "id"))
    );
  });

  startSearch({ base: import.meta.env.BASE_URL, listing });

  // Filters fold behind "Saring" on phones; on wide screens they start open. The summary says how
  // many are in use, so a folded filter is never forgotten (K-083).
  const fold = document.getElementById("saringan-lipat");
  const active = document.getElementById("saringan-aktif");
  const filterSelects = [...fold.querySelectorAll("select")];
  const countActive = () => {
    const n = filterSelects.filter((s) => s.value).length;
    active.textContent = n ? `(${n} aktif)` : "";
    if (n) fold.open = true;
  };
  if (window.matchMedia("(min-width: 48rem)").matches) fold.open = true;
  for (const s of filterSelects) s.addEventListener("change", countActive);
  window.addEventListener("hashchange", countActive);
  countActive();
</script>
