---
import Base from "../layouts/Base.astro";
import { buildListing, loadMeta } from "../lib/corpus.js";
import { statusLabel, typeLabel, yearLabel, regulationLabel } from "../lib/labels.js";
import { KINDS } from "../lib/collection/records.js";

const rows = buildListing();
const meta = loadMeta();
const base = import.meta.env.BASE_URL;
const withoutText = rows.filter((r) => !r.text_available).length;
const uncertain = rows.filter((r) => r.status_uncertain).length;

// Filter choices come from the data, each with how many documents it holds.
const countBy = (key) => {
  const counts = new Map();
  for (const row of rows) counts.set(key(row), (counts.get(key(row)) || 0) + 1);
  return counts;
};
const typeCounts = [...countBy((r) => r.code)].sort((a, b) => typeLabel(a[0]).localeCompare(typeLabel(b[0]), "id"));
const statusOrder = ["berlaku", "diubah_atau_dicabut_sebagian", "tidak_berlaku", "tidak_pasti", "tetap", "kosong"];
const statusCounts = [...countBy((r) => r.status)].sort(
  (a, b) => (statusOrder.indexOf(a[0]) + 99) % 99 - (statusOrder.indexOf(b[0]) + 99) % 99
);
const years = [...new Set(rows.map((r) => Number(r.year)).filter(Boolean))].sort((a, b) => b - a);
---

<Base title="Daftar peraturan PPh — Tax">
  <h1>Peraturan Pajak Penghasilan</h1>
  <p class="lead">
    {rows.length.toLocaleString("id-ID")} dokumen dari katalog Direktorat Jenderal Pajak dan JDIH
    Kementerian Keuangan.
  </p>

  <form class="cari" id="cari" role="search" action="" method="get">
    <label for="q">Cari kata, istilah, atau nomor peraturan</label>
    <div class="cari-baris">
      <input id="q" name="q" type="search" autocomplete="off" spellcheck="false"
        placeholder="PPh 21, natura, PMK 168/2023, PER-11/PJ/2025" />
      <button type="submit">Cari</button>
    </div>
    <div class="saringan">
      <label>Jenis
        <select name="jenis" id="jenis">
          <option value="">Semua jenis</option>
          {typeCounts.map(([code, count]) => <option value={code}>{typeLabel(code)} ({count})</option>)}
        </select>
      </label>
      <label>Dari tahun
        <select name="dari" id="dari">
          <option value="">—</option>
          {years.slice().reverse().map((year) => <option value={year}>{year}</option>)}
        </select>
      </label>
      <label>Sampai tahun
        <select name="sampai" id="sampai">
          <option value="">—</option>
          {years.map((year) => <option value={year}>{year}</option>)}
        </select>
      </label>
      <label>Sumber
        <select name="sumber" id="sumber">
          <option value="">Peraturan publik dan koleksi pribadi</option>
          <option value="publik">Hanya peraturan publik</option>
          <option value="pribadi">Hanya koleksi pribadi</option>
        </select>
      </label>
      <label>Jenis koleksi
        <select name="koleksi" id="jenis-koleksi">
          <option value="">Semua jenis koleksi</option>
          {Object.entries(KINDS).map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
      <label>Status
        <select name="status" id="status">
          <option value="">Semua status</option>
          {statusCounts.map(([value, count]) => <option value={value}>{statusLabel(value)} ({count})</option>)}
        </select>
      </label>
    </div>
    <p class="hint" id="keadaan" aria-live="polite">
      Pencarian berjalan di perangkat ini. Data pencariannya dimuat sekali bersama halaman; mengetik
      tidak mengirim apa pun ke mana pun.
    </p>
    <noscript>
      <p class="hint">Pencarian dan saringan membutuhkan JavaScript. Daftar lengkap tetap ada di bawah.</p>
    </noscript>
  </form>

  <div id="hasil" hidden>
    <div class="notice" id="catatan-daerah" hidden></div>
    <section class="blok-pribadi" id="hasil-pribadi" hidden aria-label="Hasil dari koleksi pribadi">
      <h2>Koleksi pribadi</h2>
      <p class="hasil-ringkas" id="hasil-pribadi-ringkas"></p>
      <ol class="daftar" id="hasil-pribadi-daftar"></ol>
      <button type="button" class="tombol-lagi" id="lagi-pribadi" hidden>Tampilkan lebih banyak</button>
    </section>
    <section id="hasil-publik" aria-label="Hasil dari peraturan publik">
      <p class="hasil-ringkas" id="hasil-ringkas"></p>
      <ol class="daftar" id="hasil-daftar"></ol>
      <button type="button" class="tombol-lagi" id="lagi" hidden>Tampilkan lebih banyak</button>
    </section>
  </div>


  <div class="notice">
    <p>
      <strong>{uncertain.toLocaleString("id-ID")} dokumen berstatus tidak pasti</strong> karena kedua
      sumber berbeda atau bertentangan dengan bukti pencabutan di teks peraturan lain.
      <strong>{withoutText.toLocaleString("id-ID")} dokumen tanpa teks</strong> karena sumbernya
      memang hanya memuat metadata. Keduanya tetap ditampilkan, tidak disembunyikan.
    </p>
  </div>

  <div id="semua">
  <div class="toolbar">
    <label for="urut">Urutkan</label>
    <select id="urut">
      <option value="tahun-desc">Tahun, terbaru dulu</option>
      <option value="tahun-asc">Tahun, terlama dulu</option>
      <option value="judul-asc">Judul, A ke Z</option>
      <option value="jenis-asc">Jenis peraturan</option>
      <option value="status-asc">Status</option>
    </select>
    <p class="hint" id="hint">Dokumen yang dicatat berbeda oleh dua sumber selalu ditampilkan berdampingan.</p>
  </div>

  <ol class="daftar" id="daftar">
    {rows.map((row) => (
      <li
        class="kartu"
        data-tahun={row.year}
        data-judul={row.title}
        data-jenis={typeLabel(row.code)}
        data-status={statusLabel(row.status, true)}
        data-code={row.code}
        data-status-value={row.status}
        data-group={row.group_key}
        data-id={row.id}
      >
        <p class="kartu-nomor">
          <a href={`${base}dokumen/${row.id}/`}>{regulationLabel(row, row.number_as_written)}</a>
          <span class="jenis">{typeLabel(row.code)}</span>
        </p>
        <p class="kartu-judul">{row.title}</p>
        <p class="kartu-tanda">
          <span class={`tanda status-${row.status}`}>{statusLabel(row.status, true)}</span>
          <span class="tanda netral">{yearLabel(row.year)}</span>
          {row.text_available ? (
            <span class="tanda netral">{row.pasal_count} pasal</span>
          ) : (
            <span class="tanda tanpa-teks">Teks tidak tersedia di sumber</span>
          )}
          {row.attachment_mismatch > 0 && (
            <span class="tanda peringatan">Lampiran tidak cocok</span>
          )}
          {row.quality_flags.length > 0 && <span class="tanda peringatan">Penomoran janggal</span>}
        </p>
        {!row.text_available && (
          <p class="kartu-catatan">
            {row.text_unavailable_reason}. Buka di sumbernya:{" "}
            {row.source_urls.map((s, i) => (
              <>
                {i > 0 && " · "}
                <a href={s.url} rel="noopener">{s.source}</a>
              </>
            ))}
          </p>
        )}
        {row.conflicts.length > 0 && (
          <p class="kartu-catatan konflik">
            Satu peraturan ini dicatat dua sumber dengan jenis berbeda, sehingga muncul lebih dari
            sekali. Lihat juga{" "}
            {row.conflicts.map((c, i) => (
              <>
                {i > 0 && ", "}
                <a href={`${base}dokumen/${c.id}/`}>{regulationLabel([c.code, row.number, row.year, row.variant])}</a> ({typeLabel(c.code)})
              </>
            ))}
            . Keduanya sengaja tidak digabungkan, karena menggabungkan berarti memilih salah satu
            sumber sebagai yang benar.
          </p>
        )}
      </li>
    ))}
  </ol>
  </div>

  <p class="hint">
    Data diambil dari sumber pada 21–27 September 2026. Korpus berisi {meta.body_units.toLocaleString("id-ID")}{" "}
    unit pasal dan diktum.
  </p>
</Base>

<script>
  // Sorting happens in the browser so the page keeps working offline and needs no server.
  // Without JavaScript the list is still there, ordered newest first.
  const list = document.getElementById("daftar");
  const select = document.getElementById("urut");
  const items = Array.from(list.children);

  const key = (item, name) => item.dataset[name] || "";
  const comparators = {
    // an unreadable year sorts last in both directions rather than pretending to be year 0
    "tahun-desc": (a, b) => (Number(key(b, "tahun")) || -1) - (Number(key(a, "tahun")) || -1),
    "tahun-asc": (a, b) => (Number(key(a, "tahun")) || 9999) - (Number(key(b, "tahun")) || 9999),
    "judul-asc": (a, b) => key(a, "judul").localeCompare(key(b, "judul"), "id"),
    "jenis-asc": (a, b) => key(a, "jenis").localeCompare(key(b, "jenis"), "id"),
    "status-asc": (a, b) => key(a, "status").localeCompare(key(b, "status"), "id"),
  };

  select.addEventListener("change", () => {
    const compare = comparators[select.value];
    const sorted = items.slice().sort(
      (a, b) =>
        compare(a, b) ||
        // documents recorded twice stay next to each other under every ordering
        key(a, "group").localeCompare(key(b, "group")) ||
        key(a, "id").localeCompare(key(b, "id"))
    );
    const fragment = document.createDocumentFragment();
    for (const item of sorted) fragment.appendChild(item);
    list.appendChild(fragment);
  });
</script>

<script>
  import { startSearch } from "../lib/search/ui.js";

  startSearch({ base: import.meta.env.BASE_URL });
</script>
