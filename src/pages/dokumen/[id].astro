---
import Base from "../../layouts/Base.astro";
import { documentIds, documentView, unitView } from "../../lib/render/views.js";
import { renderDocumentPage } from "../../lib/render/pages.js";

export function getStaticPaths() {
  return documentIds().map((id) => ({ params: { id } }));
}

// The page body comes from a shared renderer that the service worker also runs offline (K-082);
// the build checks that both give the same page.
const doc = documentView(Astro.params.id);
const page = renderDocumentPage(doc, doc.pasal_ids.map(unitView), import.meta.env.BASE_URL);
---

<Base title={page.title} description={page.description}><Fragment set:html={page.body} /></Base>
