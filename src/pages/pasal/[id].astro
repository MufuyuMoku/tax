---
import Base from "../../layouts/Base.astro";
import { documentView, listPasalIds, unitView } from "../../lib/render/views.js";
import { renderPasalPage } from "../../lib/render/pages.js";
import { documentOfPasal } from "../../lib/render/shards.js";

export function getStaticPaths() {
  return listPasalIds().map((id) => ({ params: { id } }));
}

// Shared with the service worker, which renders this page offline (K-082).
const unit = unitView(Astro.params.id);
const page = renderPasalPage(documentView(documentOfPasal(unit.id)), unit, import.meta.env.BASE_URL);
---

<Base title={page.title} description={page.description}><Fragment set:html={page.body} /></Base>
