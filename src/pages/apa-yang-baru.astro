---
// "Apa yang baru" (K-084): release notes per app version, for the public, newest first. The app
// version follows semver (package.json); the data has its own version, its date, shown apart.
import Base from "../layouts/Base.astro";
import { APP_NAME } from "../lib/brand.js";
import { formatDate } from "../lib/labels.js";
import { dataDate } from "../lib/corpus.js";
import pkg from "../../package.json";

const base = import.meta.env.BASE_URL;
const RELEASES = [
  {
    version: "1.2.0",
    date: "2026-10-16",
    title: "Data diperbarui otomatis",
    points: [
      "Situs DJP dan JDIH kini diperiksa otomatis setiap hari. Data baru terbit paling sering seminggu sekali, hanya bila ada perubahan, dan hanya bila semua pemeriksaan lulus.",
      "Halaman baru: Peraturan baru dan yang berubah, per pembaruan. Status yang berubah ditulis per sumber, apa adanya. Bisa dibuka tanpa internet.",
      "Baris kecil di bawah menu kini menyebut kapan data terakhir diperiksa dan kapan terakhir berubah.",
      "Data baru dipasang sendiri saat aplikasi dibuka lagi. Bila halaman sedang terbuka, tetap ditawarkan Muat data baru.",
    ],
  },
  {
    version: "1.1.0",
    date: "2026-10-16",
    title: "Lebih banyak jenis pajak",
    points: [
      "Peraturan Bea Meterai, PBB, dan BPHTB dari katalog DJP kini ikut dicari dan bisa dibuka sampai ke pasalnya.",
      "Dari daftar “Lainnya” katalog DJP, peraturan yang tentang pajak ikut dimuat: tata cara dan administrasi pajak, persetujuan penghindaran pajak berganda (P3B), tempat terdaftar wajib pajak, dan pajak daerah. Bea cukai, PNBP, dan urusan organisasi tidak dimuat.",
      "Peraturan PBB, BPHTB, dan pajak daerah diberi keterangan: PBB rumah atau tanah dan BPHTB kini diatur pemerintah daerah lewat perda; yang ada di sini adalah aturan pusatnya.",
      "Saringan Kategori dan “Teratas per kategori” mengenal kategori baru.",
    ],
  },
  {
    version: "1.0.1",
    date: "2026-10-11",
    title: "Batasan diperjelas",
    points: [
      "Halaman Tentang dan batasan kini menyebut kelompok dari daftar “Lainnya” katalog DJP yang tidak akan dimuat (bea cukai, PNBP, organisasi, dan sebagainya), beserta jumlahnya.",
    ],
  },
  {
    version: "1.0.0",
    date: "2026-10-10",
    title: "Rilis pertama",
    points: [
      "Cari peraturan PPh, KUP, dan PPN dengan nomor (PMK 168/2023), singkatan (PPh 21, PTKP), istilah, atau pertanyaan sehari-hari.",
      "Hasil sampai ke pasalnya, dengan potongan kalimat yang cocok, dan tiga hasil terbaik per kategori pajak.",
      "Status tiap peraturan menurut tiap sumber resmi (DJP dan JDIH), dengan tanggal pengambilannya. Bila sumber berbeda pendapat, ditandai “⚠ Perlu dicek”.",
      "Halaman peraturan: ringkasan, daftar pasal, relasi dengan peraturan lain beserta kutipannya, dan lampiran PDF asli.",
      "Salin kutipan pasal lengkap dengan nama peraturan dan tautannya.",
      "Koleksi pribadi: simpan SE, ND, atau putusan Anda sendiri supaya ikut tercari, hanya di perangkat Anda.",
      "Bisa dipasang di HP dan dipakai tanpa internet. Data baru diunduh hanya bila berubah, dan baru dipakai setelah Anda menekan “Muat data baru”.",
      "Tema terang atau gelap, ukuran huruf, dan halaman Cara pakai.",
    ],
  },
];
---

<Base title={`Apa yang baru — ${APP_NAME}`} description={`Catatan versi ${APP_NAME}`}>
  <p class="breadcrumb"><a href={base}>← Cari peraturan</a></p>
  <h1>Apa yang baru</h1>
  <p class="lead">
    Versi aplikasi sekarang <strong>v{pkg.version}</strong>. Versi data adalah tanggal datanya:
    <strong>{formatDate(dataDate())}</strong>. Data bisa diperbarui tanpa ganti versi aplikasi.
  </p>
  {RELEASES.map((release) => (
    <section class="rilis">
      <h2>v{release.version} · {formatDate(release.date)}</h2>
      <p><strong>{release.title}</strong></p>
      <ul>{release.points.map((point) => <li>{point}</li>)}</ul>
    </section>
  ))}
</Base>
