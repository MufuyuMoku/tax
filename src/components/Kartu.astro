---
// One card of the regulation list. Used by the list page, where most cards wait in a <template>
// until shown (K-074), and by /semua/, the full list for browsers without JavaScript.
// Status is shown per source, as chips with icon and words (K-083); never one status per document.
import { statusLabel, typeLabel, yearLabel, regulationLabel, categoryNote, plainReason } from "../lib/labels.js";
import { statusChips } from "../lib/render/chips.js";

const { row } = Astro.props;
const base = import.meta.env.BASE_URL;
const meta = [yearLabel(row.year), row.text_available ? `${row.pasal_count} pasal` : null, categoryNote(row.category_list) || null].filter(Boolean);
---

<li
  class="kartu"
  data-tahun={row.year}
  data-judul={row.title}
  data-jenis={typeLabel(row.code)}
  data-status={statusLabel(row.status, true)}
  data-code={row.code}
  data-kategori={row.categories.join(" ")}
  data-status-value={row.status}
  data-group={row.group_key}
  data-id={row.id}
>
  <p class="kartu-nomor">
    <a href={`${base}dokumen/${row.id}/`}>{regulationLabel(row, row.number_as_written)}</a>
    <span class="jenis">{typeLabel(row.code)}</span>
  </p>
  <p class="kartu-judul">{row.title}</p>
  <p class="kartu-status">
    <Fragment set:html={statusChips(row.claims)} />
    <a class="info" href={`${base}cara-pakai/#status`} aria-label="Arti status menurut sumber">ⓘ</a>
  </p>
  {row.status === "tidak_pasti" && (
    <p class="kartu-catatan konflik">⚠ Perlu dicek: {row.status_reasons.map(plainReason).join("; ")}.</p>
  )}
  <p class="kartu-meta">
    {meta.join(" · ")}
    {!row.text_available && <span class="tanda tanpa-teks">Tanpa teks di situs ini</span>}
    {row.attachment_mismatch > 0 && <span class="tanda peringatan">Lampiran tidak cocok</span>}
    {row.quality_flags.length > 0 && <span class="tanda peringatan">Penomoran janggal</span>}
  </p>
  {!row.text_available && (
    <p class="kartu-catatan">
      {row.text_unavailable_reason}. Baca di sumbernya:{" "}
      {row.source_urls.map((s, i) => (
        <>
          {i > 0 && " · "}
          <a href={s.url} rel="noopener">{s.source}</a>
        </>
      ))}
    </p>
  )}
  {row.conflicts.length > 0 && (
    <p class="kartu-catatan konflik">
      Dicatat juga sebagai{" "}
      {row.conflicts.map((c, i) => (
        <>
          {i > 0 && ", "}
          <a href={`${base}dokumen/${c.id}/`}>{regulationLabel([c.code, row.number, row.year, row.variant])}</a> ({typeLabel(c.code)})
        </>
      ))}
      : sumber mencatat jenisnya berbeda, jadi sengaja tidak digabung.
    </p>
  )}
</li>
