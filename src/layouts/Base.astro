---
import "../styles/global.css";
import "../styles/tampilan.css";
import { dataDate } from "../lib/corpus.js";
import { formatDate } from "../lib/labels.js";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Pencari peraturan pajak Indonesia" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- No icon file: without this line browsers request /favicon.ico on their own. -->
    <link rel="icon" href="data:," />
    {/* Installing on a phone and offline use (M6, K-082). */}
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}ikon-192.png`} />
    <meta name="theme-color" content="#1f4f82" />
    {/* Theme and text size chosen by the reader, applied before the page is drawn (K-083). */}
    <script is:inline>try{var d=document.documentElement,t=localStorage.getItem("tax-tema"),h=localStorage.getItem("tax-huruf");if(t)d.dataset.theme=t;if(h)d.dataset.huruf=h}catch(e){}</script>
  </head>
  <body>
    <div class="wrap">
      <header class="atas">
        <a class="merek" href={base}>Tax</a>
        <nav aria-label="Navigasi utama">
          <a href={base}>Cari</a>
          <a href={`${base}koleksi/`}>Koleksi pribadi</a>
          <a href={`${base}cara-pakai/`}>Cara pakai</a>
        </nav>
        <details class="tampilan">
          <summary><span aria-hidden="true">Aa</span><span class="sr">Tampilan</span></summary>
          <div class="panel">
            <fieldset>
              <legend>Tema</legend>
              <label><input type="radio" name="tema" value="" checked /> Ikuti perangkat</label>
              <label><input type="radio" name="tema" value="light" /> Terang</label>
              <label><input type="radio" name="tema" value="dark" /> Gelap</label>
            </fieldset>
            <fieldset>
              <legend>Ukuran huruf</legend>
              <label><input type="radio" name="huruf" value="" checked /> Biasa</label>
              <label><input type="radio" name="huruf" value="besar" /> Besar</label>
              <label><input type="radio" name="huruf" value="sangat-besar" /> Sangat besar</label>
            </fieldset>
          </div>
        </details>
      </header>
      {/* When the data was read from its sources, which version is kept on this device, and
          whether the device is online: one line, details on tap. Filled in by public/keadaan.js. */}
      <details class="keadaan" id="keadaan-situs">
        <summary>
          <span>Data per {formatDate(dataDate())}</span>
          <span id="ringkas-simpan"></span>
          <span id="keadaan-jaringan"></span>
        </summary>
        <p>Data sumber diambil sampai {formatDate(dataDate())}.</p>
        <p id="keadaan-simpan">Belum tersimpan untuk dipakai luring.</p>
      </details>
      <div class="notice tawaran" id="tawaran-baru" hidden>
        <p id="tawaran-teks"></p>
        <button type="button" id="muat-baru">Muat data baru</button>
      </div>
      <slot />
      <!-- Invariant: the site must always state that it is not an official government site
           and must name the sources of its data. -->
      <footer>
        <p>
          <strong>Tax</strong> bukan situs resmi pemerintah dan tidak berafiliasi dengan
          Kementerian Keuangan maupun Direktorat Jenderal Pajak.
        </p>
        <p>
          Sumber data: katalog peraturan Direktorat Jenderal Pajak
          (<a href="https://www.pajak.go.id/id/peraturan">pajak.go.id</a>) dan JDIH Kementerian
          Keuangan (<a href="https://jdih.kemenkeu.go.id">jdih.kemenkeu.go.id</a>). Setiap dokumen
          membawa URL sumber dan tanggal pengambilannya. Untuk kepastian hukum, rujuk naskah resmi
          di sumbernya.
        </p>
      </footer>
    </div>
    <script is:inline type="module" src={`${base}keadaan.js`}></script>
  </body>
</html>
