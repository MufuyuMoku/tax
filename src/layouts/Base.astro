---
import "../styles/global.css";
import { dataDate } from "../lib/corpus.js";
import { formatDate } from "../lib/labels.js";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Pencari peraturan pajak Indonesia" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- No icon file: without this line browsers request /favicon.ico on their own. -->
    <link rel="icon" href="data:," />
    {/* Installing on a phone and offline use (M6, K-082). */}
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}ikon-192.png`} />
    <meta name="theme-color" content="#1f4f82" />
  </head>
  <body>
    <div class="wrap">
      <nav class="atas" aria-label="Navigasi utama">
        <a href={import.meta.env.BASE_URL}>Peraturan</a>
        <a href={`${import.meta.env.BASE_URL}koleksi/`}>Koleksi pribadi</a>
      </nav>
      {/* When the data was read from its sources, which version is kept on this device, and
          whether the device is online. Filled in by public/keadaan.js. */}
      <div class="keadaan" id="keadaan-situs">
        <span>Data sumber diambil sampai {formatDate(dataDate())}.</span>
        <span id="keadaan-simpan"></span>
        <span id="keadaan-jaringan"></span>
      </div>
      <div class="notice tawaran" id="tawaran-baru" hidden>
        <p id="tawaran-teks"></p>
        <button type="button" id="muat-baru">Muat data baru</button>
      </div>
      <slot />
      <!-- Invariant: the site must always state that it is not an official government site
           and must name the sources of its data. -->
      <footer>
        <p>
          <strong>Tax</strong> bukan situs resmi pemerintah dan tidak berafiliasi dengan
          Kementerian Keuangan maupun Direktorat Jenderal Pajak.
        </p>
        <p>
          Sumber data: katalog peraturan Direktorat Jenderal Pajak
          (<a href="https://www.pajak.go.id/id/peraturan">pajak.go.id</a>) dan JDIH Kementerian
          Keuangan (<a href="https://jdih.kemenkeu.go.id">jdih.kemenkeu.go.id</a>). Setiap dokumen
          membawa URL sumber dan tanggal pengambilannya. Untuk kepastian hukum, rujuk naskah resmi
          di sumbernya.
        </p>
      </footer>
    </div>
    <script is:inline type="module" src={`${base}keadaan.js`}></script>
  </body>
</html>
